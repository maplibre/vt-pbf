{
    "compilerOptions": {
        "esModuleInterop": true,
        "allowJs": true,
        "checkJs": true,
        "strict": true,
        "declaration": true,
        "noEmit": true,
        "isolatedModules": true,
        "target": "es2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "declarationDir": "dist/",
        "types": ["geojson", "node"],
        "typeRoots": [
            "types/**/*.d.ts",
            "node_modules/@types"
        ]
    },
    "include": ["**/*.ts"]
}
